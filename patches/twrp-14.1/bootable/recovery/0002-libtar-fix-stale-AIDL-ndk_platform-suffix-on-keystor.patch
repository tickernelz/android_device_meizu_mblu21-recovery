From d972436fbbbf47c7b0a5c1a7e20128233b2b71b4 Mon Sep 17 00:00:00 2001
From: Jamie Leigh Falconer <mrfluffyoven@gmail.com>
Date: Sat, 25 Jul 2026 12:57:54 +0000
Subject: [PATCH 2/4] libtar: fix stale AIDL ndk_platform suffix on
 keystore2/apc modules

   libtar/Android.mk and Android.mk's TW_INCLUDE_CRYPTO_FBE block both
   referenced the deprecated "-ndk_platform" AIDL backend suffix for
   android.security.apc, android.system.keystore2-V1,
   android.security.authorization, and android.security.maintenance.

   That suffix no longer exists in this AOSP snapshot (see
   build/make/target/product/gsi/Android.mk: "*-ndk_platform.so
   libraries no longer exist"); the rest of the tree already references
   these modules by their current "-ndk" names (e.g.
   system/security/keystore-engine/Android.bp uses
   android.system.keystore2-V1-ndk). The stale references caused:

     ninja: 'out/.../android.security.apc-ndk_platform.so.toc', needed
     by '.../libtar.so', missing and no known rule to make it

   Update all four references in both files to drop the "_platform"
   suffix, matching the module names as currently defined.

   Test: full recovery build for m55xq (SM7450) links libtar and
   proceeds past the SHARED_LIBRARIES stage without error

Change-Id: I0904b417f3fa775613a8892301521b190034ccd1
---
 Android.mk        | 9 +++++----
 libtar/Android.mk | 8 ++++----
 2 files changed, 9 insertions(+), 8 deletions(-)

diff --git a/Android.mk b/Android.mk
index 78b9430..2f007dc 100755
--- a/Android.mk
+++ b/Android.mk
@@ -334,14 +334,15 @@ ifeq ($(TW_INCLUDE_CRYPTO), true)
     TW_INCLUDE_CRYPTO_FBE := true
     LOCAL_CFLAGS += -DTW_INCLUDE_FBE
     LOCAL_SHARED_LIBRARIES += android.frameworks.stats@1.0 android.hardware.authsecret@1.0 \
-	android.security.authorization-ndk_platform \
-        android.hardware.oemlock@1.0 libf2fs_sparseblock \
+	android.security.authorization-ndk \
+        android.hardware.oemlock@1.0 \
+        libf2fs_sparseblock \
         libandroidicu.recovery \
         android.hardware.gatekeeper@1.0 \
         android.hardware.weaver@1.0 \
         android.frameworks.stats@1.0 \
-        android.security.maintenance-ndk_platform \
-        android.system.keystore2-V1-ndk_platform \
+        android.security.maintenance-ndk \
+        android.system.keystore2-V1-ndk \
         libkeyutils \
         liblog \
         libsqlite.recovery \
diff --git a/libtar/Android.mk b/libtar/Android.mk
index c3bb691..008125a 100755
--- a/libtar/Android.mk
+++ b/libtar/Android.mk
@@ -23,10 +23,10 @@ ifeq ($(TW_INCLUDE_CRYPTO_FBE), true)
         android.hardware.keymaster@4.0 \
         android.hardware.keymaster@4.1 \
         android.hardware.weaver@1.0 \
-        android.security.apc-ndk_platform \
-        android.system.keystore2-V1-ndk_platform \
-        android.security.authorization-ndk_platform \
-        android.security.maintenance-ndk_platform \
+        android.security.apc-ndk \
+        android.system.keystore2-V1-ndk \
+        android.security.authorization-ndk \
+        android.security.maintenance-ndk \
         libselinux \
         libbinder_ndk \
         libext4_utils \
