From 906f9bf0b014150f0525b15b95fa672957e1e38d Mon Sep 17 00:00:00 2001
From: Jamie Leigh Falconer <mrfluffyoven@gmail.com>
Date: Sat, 25 Jul 2026 12:06:45 +0000
Subject: [PATCH 1/4] prebuilt: fix missing task_profiles.json dependency in
 twrp_ramdisk" \   -m "The twrp_ramdisk LOCAL_POST_INSTALL_CMD copies
 task_profiles.json into the recovery ramdisk but it wasn't listed in
 LOCAL_REQUIRED_MODULES like the other context files this rule depends on.
 TWRP product makefiles skip base_system.mk so the module was never built,
 causing:   cp: bad '.../system/etc/task_profiles.json': No such file or
 directory

Add task_profiles.json to LOCAL_REQUIRED_MODULES.

Test: full recovery build for m55xq (SM7450) no longer fails at
twrp_ramdisk-timestamp

Change-Id: Iab4240ab0bd54d76a4e84a743857ad75a09a1398
---
 prebuilt/Android.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/prebuilt/Android.mk b/prebuilt/Android.mk
index f3b7160..fa83e52 100755
--- a/prebuilt/Android.mk
+++ b/prebuilt/Android.mk
@@ -473,7 +473,8 @@ LOCAL_REQUIRED_MODULES += init_second_stage.recovery \
     plat_hardware_contexts \
     vndservice_contexts \
     plat_keystore2_key_contexts \
-    vendor_hwservice_contexts
+    vendor_hwservice_contexts \
+    task_profiles.json
 
 include $(BUILD_PHONY_PACKAGE)
 
