system /system erofs ro wait,slotselect,logical,first_stage_mount
system_ext /system_ext erofs ro wait,slotselect,logical,first_stage_mount
product /product erofs ro wait,slotselect,logical,first_stage_mount
vendor /vendor erofs ro wait,slotselect,logical,first_stage_mount
odm /odm erofs ro wait,slotselect,logical,first_stage_mount
vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,logical,first_stage_mount
system_dlkm /system_dlkm erofs ro wait,slotselect,logical,first_stage_mount

/dev/block/by-name/metadata /metadata f2fs nodev,noatime,nosuid wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier,atgc latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs
/dev/block/by-name/cache /cache f2fs noatime,nosuid,nodev,discard wait,check,formattable
/dev/block/by-name/misc /misc emmc defaults defaults

/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/init_boot /init_boot emmc defaults slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect
/dev/block/by-name/vbmeta /vbmeta emmc defaults slotselect
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults slotselect
/dev/block/by-name/vbmeta_system_ext /vbmeta_system_ext emmc defaults slotselect
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults slotselect
/dev/block/by-name/vbmeta_product /vbmeta_product emmc defaults slotselect
/dev/block/by-name/vbmeta_odm /vbmeta_odm emmc defaults slotselect
